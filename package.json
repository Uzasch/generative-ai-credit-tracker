{
  "name": "token-tracker-for-ai-generation",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:extension": "pnpm --filter @token-tracker/extension dev",
    "dev:dashboard": "pnpm --filter @token-tracker/dashboard dev",
    "dev:convex": "pnpm --filter @token-tracker/convex dev",
    "build": "pnpm -r run build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "pnpm -r --parallel run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "^4.3.4"
    }
  }
}
